# Guidekeep contains instructions, documentation and a static HTML template.
# There is no Node.js build or bundled Python environment.
# Dependency lock files are intentionally not ignored.

# Credentials and machine-local authentication.
# .env.example may be published only with placeholder values.
# Ignore rules do not remove tracked files or secrets from Git history.
.env
.env.*
!.env.example
.netrc
*.pem
*.key
*.p12
*.pfx
*.kdbx
**/auth.json
**/credentials.json
**/cookies.json
**/cookies.txt
**/token.txt
**/tokens.json
**/login.png
**/login-*.png
**/qr.png
**/qrcode*.png
/.agent-reach/
/secrets/
/credentials/
/.codex/auth.*
/.codex/*.local.toml
/.codex/sessions/
/.codex/log/

# Generated archives and collected third-party material belong outside this repo.
/guidekeep-archive/
/guides/
/archive/
/archives/
/artifacts/
/evidence/
